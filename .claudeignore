# VinoInvest — .claudeignore
# Riduce l'80%+ del contesto inutile che Claude legge

# Dipendenze
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp/
.yarn/

# Build output
frontend/dist/
frontend/.vite/
build/
dist/
*.tsbuildinfo

# Env e secrets — MAI nel contesto
.env
.env.*
*.pem
*.key
*.cert
secrets/

# Git
.git/
*.orig

# Lock files
package-lock.json
frontend/package-lock.json
backend/package-lock.json
yarn.lock
pnpm-lock.yaml

# Cache e logs
.cache/
*.log
/tmp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp

# Docs generati
docs/generated/
