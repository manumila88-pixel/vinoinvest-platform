# ─────────────────────────────────────────────────────────────
# VinoInvest Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Supabase Auth ─────────────────────────────────────────────
# https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── Payments ─────────────────────────────────────────────────
# Stripe publishable key — https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# PayPal client ID — https://developer.paypal.com/dashboard/
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID

# ── Backend ───────────────────────────────────────────────────
# Local development
VITE_BACKEND_URL=http://localhost:3001
# Production (Render)
# VITE_BACKEND_URL=https://vinoinvest-backend-2.onrender.com
