# ─────────────────────────────────────────────────────────────
# VinoInvest Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────────────
# Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/vinoinvest_db

# ── Supabase Auth ─────────────────────────────────────────────
# https://supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── AI / LLM ─────────────────────────────────────────────────
# Anthropic Claude — https://console.anthropic.com/
# Used for: AI chat agent, AI score, portfolio analysis
# Leave empty to use the free algorithmic fallback
ANTHROPIC_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
# Used for: market sentiment analysis via FinBERT (ProsusAI/finbert)
# Free tier works without key; key removes rate limits
HUGGINGFACE_API_KEY=

# ── Payments ─────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# PayPal — https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# NowPayments (crypto) — https://nowpayments.io/
NOWPAYMENTS_API_KEY=

# ── Wine Price Sources ────────────────────────────────────────
# Liv-ex API (paid) — https://api.liv-ex.com/
LIVEX_API_KEY=
LIVEX_API_BASE_URL=https://api.liv-ex.com

# CellarTracker (free, no auth required) — used automatically
# No key needed — uses public CSV endpoint

# News API (optional) — https://newsapi.org/
# Free tier: 100 req/day. Leave empty to use built-in fallback news.
NEWS_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────
# Resend — https://resend.com (free tier: 3,000 emails/month)
# Used for: price alerts, welcome emails, newsletter, email flows
# Without this key, emails silently fail (no crash, no send)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY

# SendGrid (legacy, used only for demo request form)
SENDGRID_API_KEY=
SMTP_USER=
SMTP_PASS=

# Admin notifications (security events, demo requests)
ADMIN_EMAIL=admin@vinoinvest.com
ADMIN_SECRET=generate-a-random-64-char-string-here

# Sentry error monitoring
SENTRY_DSN=

# ── Web Push (VAPID) ─────────────────────────────────────────
# Keys generated 2026-06-11 — copy to Render environment variables
VAPID_PUBLIC_KEY=BFUHJdKrrhpoLx7EY-gUZXRVLBEjdzotlDPqduqUTw0Wiqos_EXyFlVJDbFMqWLUtaobxNUF7s12_Fgg3p-OROo
VAPID_PRIVATE_KEY=YypXfy4Mh_nqvzQNFruuQhbhH2Qq77-dcdaLk7bZdT4

# ── Feature Flags ────────────────────────────────────────────
# Set to true to enable real order processing (requires Stripe live key)
ENABLE_REAL_ORDERS=false
